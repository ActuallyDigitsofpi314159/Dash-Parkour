#!/usr/bin/env bash
# DASH Parkour watchdog: runs every 2 minutes (dash-watchdog.timer), checks
# that everything works and fixes what it can. Its notes go to
# /var/lib/dash-party/watchdog.log (see them with: dash-party).
set -u
DATA=/var/lib/dash-party
ETC=/etc/dash-party
APP=/opt/dash-party
LOG="$DATA/watchdog.log"
STATE="$DATA/watchdog.state"
SVC_USER=dashparty
[ -r "$ETC/setup.conf" ] && . "$ETC/setup.conf"
PARTY_HOST="${PARTY_HOST:-}"
now=$(date +%s)

note() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOG"; }
# a tiny key=value memory between runs
get() { grep -E "^$1=" "$STATE" 2>/dev/null | tail -1 | cut -d= -f2-; }
put() { touch "$STATE"; grep -vE "^$1=" "$STATE" >"$STATE.tmp" 2>/dev/null; echo "$1=$2" >>"$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }
num() { local v; v="$(get "$1")"; echo "${v:-0}"; }

# keep the log small (about 1 MB)
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 1000000 ]; then tail -n 2000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"; fi

# ---- 1. internet ----
NET=up
if ! curl -fsS -m 8 -o /dev/null https://1.1.1.1/cdn-cgi/trace && ! curl -fsS -m 8 -o /dev/null https://www.google.com/generate_204; then NET=down; fi
if [ "$NET" = down ]; then
  [ "$(get net)" != down ] && note "PROBLEM internet is down (waiting for it; everything restarts by itself when it's back)"
  put net down
else
  [ "$(get net)" = down ] && note "FIXED internet is back"
  put net up
fi

# ---- 2. the server on the Pi ----
LOCAL=ok
if ! curl -fsS -m 5 -o /dev/null http://127.0.0.1:8787/api/health; then
  LOCAL=bad
  n=$(( $(num localfail) + 1 )); put localfail "$n"
  note "PROBLEM the party server doesn't answer (try $n)"
  if [ "$n" -ge 1 ]; then
    systemctl restart dash-party && note "FIX restarted the party server"
  fi
else
  [ "$(num localfail)" -gt 0 ] && note "FIXED the party server answers again"
  put localfail 0
fi

# ---- 3. from the internet (through the tunnel) ----
PUBLIC=unknown
if [ "$NET" = up ] && [ -n "$PARTY_HOST" ] && [ -s "$ETC/tunnel.json" ]; then
  if curl -fsS -m 12 -o /dev/null "https://$PARTY_HOST/api/health"; then
    PUBLIC=ok
    [ "$(num pubfail)" -gt 0 ] && note "FIXED https://$PARTY_HOST answers again"
    put pubfail 0
  else
    PUBLIC=bad
    n=$(( $(num pubfail) + 1 )); put pubfail "$n"
    note "PROBLEM https://$PARTY_HOST doesn't answer (try $n)"
    if ! systemctl is-active --quiet dash-tunnel || [ $((n % 2)) -eq 0 ]; then
      systemctl restart dash-tunnel && note "FIX restarted the tunnel"
    fi
    # stuck for an hour with the internet working: restart the whole Pi
    # (at most once every 12 hours)
    last=$(num lastreboot)
    if [ "$n" -ge 30 ] && [ "$LOCAL" = ok ] && [ $((now - last)) -gt 43200 ]; then
      put lastreboot "$now"; put pubfail 0
      note "FIX nothing else helped for an hour: restarting the Pi"
      sync; systemctl reboot
    fi
  fi
fi

# ---- 4. room on the SD card ----
free_mb=$(df -Pm / | awk 'NR==2{print $4}')
if [ "${free_mb:-9999}" -lt 300 ]; then
  note "PROBLEM only ${free_mb} MB free on the SD card"
  journalctl --vacuum-size=50M >/dev/null 2>&1 && note "FIX cleaned old system logs"
  apt-get clean >/dev/null 2>&1
fi

# ---- 5. updates from GitHub (website files and server.js) every 15 minutes ----
# Only the website and server.js (which runs locked down as $SVC_USER) update by
# themselves. The setup and this watchdog only change when you run the setup.
last=$(num lastpull)
if [ "$NET" = up ] && [ -d "$APP/repo/.git" ] && [ $((now - last)) -ge 900 ]; then
  put lastpull "$now"
  before=$(sudo -u "$SVC_USER" git -C "$APP/repo" rev-parse HEAD 2>/dev/null)
  # (fetch + reset: the copy here always matches GitHub exactly, even after
  # history on GitHub was rewritten, which made "git pull" fail forever)
  if sudo -u "$SVC_USER" git -C "$APP/repo" fetch -q --depth 1 origin HEAD >/dev/null 2>&1 &&
     sudo -u "$SVC_USER" git -C "$APP/repo" reset -q --hard FETCH_HEAD >/dev/null 2>&1; then
    after=$(sudo -u "$SVC_USER" git -C "$APP/repo" rev-parse HEAD 2>/dev/null)
    if [ "$before" != "$after" ]; then
      note "UPDATE got the newest files from GitHub (${after:0:7})"
    fi
  else
    note "PROBLEM couldn't get updates from GitHub (will try again)"
  fi
  # (checked every time, not only when something new came in)
  if [ -f "$APP/repo/dash-server/server.js" ] && ! cmp -s "$APP/repo/dash-server/server.js" "$APP/server.js"; then
    if node --check "$APP/repo/dash-server/server.js" 2>/dev/null; then
      install -m 644 "$APP/repo/dash-server/server.js" "$APP/server.js" && systemctl restart dash-party && note "UPDATE new server.js installed"
    else
      note "PROBLEM the new server.js on GitHub has a mistake in it, kept the old one"
    fi
  fi
fi

# ---- status for the dashboard ----
cat >"$DATA/watchdog.json.tmp" <<EOF
{"at":$now,"net":"$NET","local":"$LOCAL","public":"$PUBLIC","free_mb":${free_mb:-0}}
EOF
mv "$DATA/watchdog.json.tmp" "$DATA/watchdog.json"
chown "$SVC_USER:$SVC_USER" "$LOG" "$STATE" "$DATA/watchdog.json" 2>/dev/null
[ "$LOCAL" = ok ] && [ "$PUBLIC" != bad ]
