#!/usr/bin/env bash
# dash-party: see what the DASH Parkour server is doing, and look after it.
#   dash-party            live status screen (Ctrl+C to leave)
#   dash-party log        everything as it happens (Ctrl+C to leave)
#   dash-party errors     just the problems
#   dash-party keys       the admin keys for /kick and /ban (keep private!)
#   dash-party setkey NAME  choose your own admin key (NAME: digitsofpi or kineto)
#   dash-party bans       who is banned
#   dash-party history    the last 50 parties: who made them, who came and went
#   dash-party history N  everything that happened in party number N
#   dash-party stats      how the game is doing: players online, per day, peaks, busy hours
#   dash-party unban NAME let someone back in
#   dash-party notify     phone notices when a party is made (on | off | test)
#   dash-party turn       the relay for players who can't link directly (set | pi | guide | off)
#   dash-party restart    restart the server and the tunnel
#   dash-party fix        run the watchdog's checks and fixes now
#   dash-party update     get the newest version from GitHub and set it up again
set -u
DATA=/var/lib/dash-party
ETC=/etc/dash-party
[ -r "$ETC/setup.conf" ] && . "$ETC/setup.conf" 2>/dev/null
B=$'\e[1m'; D=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; N=$'\e[0m'
S() { sudo -n "$@" 2>/dev/null || sudo "$@"; }
yes_no() { if [ "$1" = ok ]; then printf '%s●%s %s' "$G" "$N" "$2"; elif [ "$1" = warn ]; then printf '%s●%s %s' "$Y" "$N" "$2"; else printf '%s●%s %s' "$R" "$N" "$2"; fi; }
ago() { local s=$(( $(date +%s) - ${1:-0} )); if [ "$s" -lt 120 ]; then echo "${s}s ago"; elif [ "$s" -lt 7200 ]; then echo "$((s / 60))m ago"; else echo "$((s / 3600))h ago"; fi; }

# [v1.5] how the game is doing (every game on the website checks in, not only multiplayer)
stats() {
  local f="$DATA/stats.json" st
  if ! S test -r "$f"; then echo "No stats yet: they start a minute after the server updates."; return; fi
  st="$(S cat "$DATA/status.json" 2>/dev/null)"
  echo "${B}${R}DASH${N}${B} PARKOUR: how the game is doing${N}"
  echo
  echo "  Playing right now:  ${B}$(echo "$st" | jq -r '.online.n // 0')${N}  ${D}($(echo "$st" | jq -r '.online.mp // 0') in multiplayer)${N}"
  S cat "$f" | jq -r '
    def when: if . > 0 then (./1000 | strflocaltime("%a %b %-d, %-I:%M %p")) else "never" end;
    "  Most at once ever:  \u001b[1m\(.peak.n)\u001b[0m  (\(.peak.at | when))",
    "  Most in multiplayer at once: \(.mpPeak.n)  (\(.mpPeak.at | when))",
    "  Different players since \(.since/1000 | strflocaltime("%b %-d")): \u001b[1m\(.devices | length)\u001b[0m",
    "",
    "  Day          players  new  multiplayer  most at once  parties  joins",
    (.days | to_entries | sort_by(.key) | .[-14:] | reverse[] |
      "  \(.key)   \(.value.players | tostring | (" " * (7 - length)) + .)  \(.value.newPlayers | tostring | (" " * (3 - length)) + .)  \(.value.mpPlayers | tostring | (" " * (11 - length)) + .)  \(.value.peak | tostring | (" " * (12 - length)) + .)  \(.value.parties | tostring | (" " * (7 - length)) + .)  \(.value.joins | tostring | (" " * (5 - length)) + .)"),
    "",
    "  Busiest hours (average players online, Pi time):",
    ( [range(0;24)] as $h | ([.hourSum, .hourN] | transpose | map(if .[1] > 0 then .[0] / .[1] else 0 end)) as $avg |
      ($avg | max) as $m |
      $h[] | . as $i | "   \(if $i < 10 then "0" else "" end)\($i):00  \("#" * (if $m > 0 then ($avg[$i] / $m * 40 | floor) else 0 end)) \($avg[$i] * 10 | round / 10)" ),
    "",
    "  Joins that never linked up (last 7 days), and why:",
    ( [.days | to_entries | sort_by(.key) | .[-7:][] | .value.failWhy // {} | to_entries[]] | group_by(.key) | map({k: .[0].key, n: (map(.value) | add)}) | sort_by(-.n) | .[:12] |
      if length == 0 then "   none reported" else .[] | "   \(.n | tostring | (" " * (4 - length)) + .)  \(.k)" end )
  '
  echo
  echo "${D}(Each device is counted by a random id the game makes; no names or addresses are kept.)${N}"
}

dashboard() {
  local st wd
  st="$(S cat "$DATA/status.json" 2>/dev/null)"; wd="$(S cat "$DATA/watchdog.json" 2>/dev/null)"
  clear
  echo "${B}${R}DASH${N}${B} PARKOUR server${N}   $(date '+%a %H:%M:%S')   ${D}Ctrl+C to leave${N}"
  echo
  if systemctl is-active --quiet dash-party; then yes_no ok "Party server running"; else yes_no bad "Party server STOPPED"; fi; echo
  if systemctl is-active --quiet dash-tunnel; then yes_no ok "Cloudflare tunnel running"; else yes_no bad "Cloudflare tunnel STOPPED"; fi; echo
  local net pub
  net="$(printf '%s' "$wd" | jq -r '.net // "?"' 2>/dev/null)"; pub="$(printf '%s' "$wd" | jq -r '.public // "?"' 2>/dev/null)"
  if [ "$net" = up ]; then yes_no ok "Internet"; elif [ "$net" = down ]; then yes_no bad "Internet is DOWN (waiting for it)"; else yes_no warn "Internet: not checked yet"; fi; echo
  if [ "$pub" = ok ]; then yes_no ok "https://${PARTY_HOST:-?} reachable"; elif [ "$pub" = bad ]; then yes_no bad "https://${PARTY_HOST:-?} NOT reachable (the watchdog is fixing it)"; else yes_no warn "https://${PARTY_HOST:-?}: not checked yet"; fi; echo
  if [ "${HOST_SITE:-no}" = yes ]; then echo "  ${D}website:${N} https://${DOMAIN:-?}  ${D}(files from GitHub, updated every 15 min)${N}"; fi
  echo
  if [ -n "$st" ]; then
    local parties players up bans made joins
    parties="$(printf '%s' "$st" | jq -r .parties)"; players="$(printf '%s' "$st" | jq -r .players)"; up="$(printf '%s' "$st" | jq -r .up)"
    bans="$(printf '%s' "$st" | jq -r .bans)"; made="$(printf '%s' "$st" | jq -r .stats.made)"; joins="$(printf '%s' "$st" | jq -r .stats.joins)"
    echo "  ${B}$parties${N} parties now, ${B}$players${N} players   ${D}| since start: $made parties, $joins joins | up $((up / 3600))h $(((up % 3600) / 60))m | $bans banned${N}"
    echo "  ${B}$(echo "$st" | jq -r '.online.n // 0')${N} playing DASH Parkour right now ${D}($(echo "$st" | jq -r '.online.mp // 0') in multiplayer, $(echo "$st" | jq -r '.online.game // 0') in a level) | dash-party stats for more${N}"
  else
    echo "  ${D}(no numbers yet)${N}"
  fi
  local freem; freem="$(df -Pm / | awk 'NR==2{print $4}')"
  echo "  ${D}Pi: $(cut -d' ' -f1 /proc/loadavg) load, $(free -m | awk '/Mem:/{print $7}') MB memory free, $freem MB SD card free, $(vcgencmd measure_temp 2>/dev/null | cut -d= -f2)${N}"
  echo
  echo "${B}What the watchdog did lately${N} ${D}(checks every 2 minutes)${N}"
  S tail -n 8 "$DATA/watchdog.log" 2>/dev/null | sed -e "s/PROBLEM/${R}PROBLEM${N}/; s/FIXED/${G}FIXED${N}/; s/FIX /${Y}FIX${N} /; s/UPDATE/${C}UPDATE${N}/; s/^/  /" || echo "  ${D}nothing yet${N}"
  echo
  echo "${B}Recent errors${N}"
  local errs; errs="$(journalctl -u dash-party -u dash-tunnel --since '-6h' -p err --no-pager -q -o short 2>/dev/null | tail -n 5)"
  if [ -n "$errs" ]; then printf '%s\n' "$errs" | cut -c1-150 | sed 's/^/  /'; else echo "  ${G}none in the last 6 hours${N}"; fi
  echo
  echo "${D}dash-party log | errors | history | keys | setkey NAME | bans | unban NAME | notify | restart | fix | update${N}"
}

# the last 50 parties, from the server's history.json (newest first)
HISTORY_JQ=$(cat <<'JQ'
def dur: (. / 1000 | floor) as $s | if $s < 60 then "\($s)s" elif $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h \($s % 3600 / 60 | floor)m" else "\($s / 86400 | floor)d \($s % 86400 / 3600 | floor)h" end;
def tm: . / 1000 | floor | strflocaltime("%a %b %d %H:%M");
def clock: . / 1000 | floor | strflocaltime("%b %d %H:%M:%S");
def plural($w): if . == 1 then "1 \($w)" else "\(.) \($w)s" end;
def what: {made: "made the party", join: "joined", leave: "left", start: "started playing", stop: "back to the lobby",
  adminjoin: "moderator joined", wrongpass: "wrong passcode", full: "turned away (full)", banned: "turned away (banned)", kick: "kicked", ban: "banned", end: "party ended"}[.kind] // .kind;
def summary($i):
  . as $r | (if .ended > 0 then .ended else now * 1000 end) as $end |
  ([.events[] | select(.kind == "leave")] | length) as $left |
  "\($B)\($i + 1 | tostring | if length < 2 then " " + . else . end). \(.name)\($N)  by \($B)\(.host)\($N)  " +
  (if .ended > 0 then "\($D)closed\($N)" else "\($G)open, \(.n)/\(.max) now\($N)" end) +
  (if .priv then "  \($Y)private\($N)" else "" end) + "  \($D)#\(.id)\($N)\n" +
  "    \(.made | tm), up for \($B)\($end - .made | dur)\($N), most at once \(.peak)/\(.max), playing \(.playMs | dur)\n" +
  "    " + (if (.players | length) > 0 then "joined: \(.players | join(", "))" + (if $left > 0 then "  \($D)(\($left) left)\($N)" else "" end) else "\($D)nobody joined\($N)" end) + "\n" +
  ([ (if .tries > 0 then (.tries | plural("join attempt")) else empty end),
     (if .wrongPass > 0 then (.wrongPass | plural("wrong passcode")) else empty end),
     (if .full > 0 then "\(.full) turned away (full)" else empty end),
     (if .bannedTries > 0 then "\($R)\(.bannedTries) banned player tried\($N)" else empty end),
     (if .kicks > 0 then "\($Y)\(.kicks | plural("kick"))\($N)" else empty end),
     (if .bans > 0 then "\($R)\(.bans | plural("ban"))\($N)" else empty end)
   ] | if length > 0 then "    \(join(", "))\n" else "" end) +
  (if .ended > 0 then "    \($D)ended: \(.end), \(.ended | tm)\($N)\n" else "" end);
def detail($i):
  summary($i) + "    \($D)host address id: \(.hostId)  (same id = same internet connection)\($N)\n\n" +
  (if (.trimmed // 0) > 0 then "    \($D)(\(.trimmed) older events not kept)\($N)\n" else "" end) +
  ([.events[] | "    \(.t | clock)  \(what | . + (" " * ([22 - length, 1] | max)))\(.name)"] | join("\n")) + "\n";
.rooms as $rooms |
if $pick == "" then
  "\($B)Last \($rooms | length) parties\($N) \($D)(newest first. dash-party history NUMBER for the full timeline)\($N)\n",
  ($rooms | to_entries[] | .key as $k | .value | summary($k))
else
  ($pick | tonumber - 1) as $i |
  if $i < 0 or $i >= ($rooms | length) then "There's no party number \($pick). There are \($rooms | length)." else ($rooms[$i] | detail($i)) end
end
JQ
)
history() {
  local pick="${1:-}" h
  if [ -n "$pick" ] && ! [[ "$pick" =~ ^[0-9]+$ ]]; then echo "Use: dash-party history  or  dash-party history NUMBER"; exit 1; fi
  h="$(S cat "$DATA/history.json" 2>/dev/null)"
  if [ -z "$h" ]; then echo "No party history yet. It starts filling in once someone makes a party."; exit 0; fi
  local out
  out="$(printf '%s' "$h" | jq -r --arg B "$B" --arg D "$D" --arg R "$R" --arg G "$G" --arg Y "$Y" --arg N "$N" --arg pick "$pick" "$HISTORY_JQ")" || { echo "${R}Couldn't read the party history.${N}"; exit 1; }
  if [ -t 1 ] && [ -z "$pick" ]; then printf '%s\n' "$out" | less -RFX; else printf '%s\n' "$out"; fi
}

# [v1.3] phone notices (ntfy) when someone makes a party
notify() {
  local f="$DATA/notify.json" cur topic srv
  cur="$(S cat "$f" 2>/dev/null)"
  topic="$(printf '%s' "$cur" | jq -r '.topic // empty' 2>/dev/null)"
  srv="$(printf '%s' "$cur" | jq -r '.server // "https://ntfy.sh"' 2>/dev/null)"; [ -z "$srv" ] && srv="https://ntfy.sh"
  case "${1:-}" in
    on)
      if [ -z "$topic" ]; then topic="dash-party-$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')"; fi
      printf '{"topic":"%s","server":"%s"}\n' "$topic" "$srv" | S tee "$f.tmp" >/dev/null &&
        S sh -c "mv '$f.tmp' '$f' && chown dashparty:dashparty '$f' && chmod 600 '$f'" || { echo "${R}Couldn't save the setting.${N}"; exit 1; }
      echo "${G}Party notices are on.${N} (the server picks this up within 5 seconds)"
      echo
      echo "On your phone:"
      echo "  1. Install the ${B}ntfy${N} app (App Store or Google Play)."
      echo "  2. Tap ${B}+${N} (Subscribe to topic) and type this topic exactly:"
      echo
      echo "       ${B}${C}$topic${N}"
      echo
      echo "  3. Run ${B}dash-party notify test${N} to check it works."
      echo
      echo "${D}Keep the topic private: anyone who knows it gets the notices too.${N}" ;;
    off)
      S rm -f "$f" && echo "Party notices are off." ;;
    test)
      [ -z "$topic" ] && { echo "Notices are off. Turn them on with: dash-party notify on"; exit 1; }
      if curl -fsS -m 10 -H "Title: DASH party server" -H "Tags: video_game" -d "Test notice: you'll get one like this when someone makes a party." "$srv/$topic" >/dev/null; then
        echo "${G}Sent.${N} It should be on your phone in a few seconds."
      else
        echo "${R}Couldn't reach $srv.${N}"; exit 1
      fi ;;
    "")
      if [ -n "$topic" ]; then echo "Party notices are ${G}on${N}. Topic: ${B}$topic${N} on $srv"; echo "${D}dash-party notify test | off${N}"
      else echo "Party notices are off. Turn them on with: ${B}dash-party notify on${N}"; fi ;;
    *) echo "Use: dash-party notify [on | off | test]"; exit 1 ;;
  esac
}

# [v1.4] choose your own admin key instead of the long random one. Only its hash
# is kept (in admins.json); the server picks up the change within a few seconds.
setkey() {
  local who label k1 k2 h tmp
  who="$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')"
  case "$who" in
    digitsofpi) label=Digitsofpi ;;
    kineto) label=Kineto ;;
    *) echo "Use: dash-party setkey digitsofpi   (or: dash-party setkey kineto)"; exit 1 ;;
  esac
  echo "Choose the admin key for ${B}$label${N}: at least 8 characters, something you'll remember."
  echo "${D}Spaces are ignored. Nothing shows while you type.${N}"
  read -r -s -p "New key: " k1; echo
  read -r -s -p "Type it again: " k2; echo
  k1="$(printf '%s' "$k1" | tr -d '[:space:]')"; k2="$(printf '%s' "$k2" | tr -d '[:space:]')"
  [ "$k1" = "$k2" ] || { echo "${R}Those don't match.${N} Nothing changed."; exit 1; }
  [ "${#k1}" -ge 8 ] || { echo "${R}That's too short${N} (8 characters or more). Nothing changed."; exit 1; }
  h="$(printf '%s' "$k1" | sha256sum | cut -d' ' -f1)"
  tmp="$(mktemp)"
  { S cat "$DATA/admins.json" 2>/dev/null || echo '[]'; } | jq --arg n "$who" --arg h "$h" \
    'if any(.[]; .name == $n) then map(if .name == $n then .hash = $h else . end) else . + [{name: $n, hash: $h}] end' >"$tmp" \
    || { rm -f "$tmp"; echo "${R}Couldn't read the admin list.${N} Nothing changed."; exit 1; }
  S install -m 600 -o dashparty -g dashparty "$tmp" "$DATA/admins.json" || { rm -f "$tmp"; echo "${R}Couldn't save it.${N}"; exit 1; }
  rm -f "$tmp"
  # the old random key stops working: say so in the list dash-party keys shows
  S sed -i -E "s/^$label:.*/$label: (chosen with dash-party setkey on $(date '+%Y-%m-%d'), not stored)/" "$ETC/admin-keys.txt" 2>/dev/null
  echo "${G}Done.${N} $label's new key works within a few seconds. The game forgets the old"
  echo "key the next time the server refuses it, then asks for the new one."
}

# [v1.5] the Cloudflare relay (TURN): players whose networks block direct links
# [v1.6] opening the router's ports by hand, for routers that don't let the Pi do it
turn_guide() {
  local lan rs; rs="$(S cat "$DATA/relay.json" 2>/dev/null)"
  lan="$(printf '%s' "$rs" | jq -r '.lan // empty' 2>/dev/null)"; [ -z "$lan" ] && lan="$(hostname -I 2>/dev/null | awk '{print $1}')"
  cat <<GUIDE
${B}Opening your router's ports for the relay, step by step${N}

The Pi tried to open them itself (UPnP) and the router said no. You only do this once.

${B}1. Open your router's settings page.${N}
   On a computer or phone connected to your home Wi-Fi, open a browser and go to
   ${B}http://$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')${N}  (that's your router). If it asks for a password,
   it's often printed on a sticker on the router. Some routers (Eero, Google/Nest
   Wifi, Xfinity, Orbi...) use their phone app instead of a page.

${B}2. Find "Port Forwarding".${N}
   It can be under Advanced, NAT, Firewall, Virtual Servers or Gaming.
   (While you're there: if there is a "UPnP" switch, turn it ${B}on${N} and run
   ${B}dash-party turn pi${N} again instead; the Pi will do the rest itself.)

${B}3. Add these rules,${N} all sending to the Pi, ${B}$lan${N}:
     Name: DASH relay      Protocol: UDP       Ports: 3478          to $lan port 3478
     Name: DASH relay TCP  Protocol: TCP       Ports: 3478          to $lan port 3478
     Name: DASH relay range Protocol: UDP      Ports: 49160-49200   to $lan ports 49160-49200
   (If it asks for "external" and "internal" ports, use the same numbers for both.
   If it lets you pick UDP and TCP together for the first one, one rule is fine.)

${B}4. Keep the Pi's address the same.${N}
   Find "DHCP reservation", "Address reservation" or "Static IP" and reserve
   ${B}$lan${N} for the Pi (it's listed by name, e.g. digitsofpi314159server).

${B}5. Save,${N} then run ${B}dash-party turn${N} on the Pi. It checks the relay is on.

${B}6. Test it:${N} make a party at home and have someone join on a phone using
   mobile data (not Wi-Fi). If they get in, it works.

Stuck, or your provider doesn't allow it? Use Cloudflare's relay instead (no
router changes, hides your home IP): ${B}dash-party turn set${N}
GUIDE
}
turn() {
  local f="$DATA/turn.json" id tok acct an bud tmp host pub sec lan j
  case "${1:-}" in
    set)
      echo "Cloudflare's relay: free for 1,000 GB a month. The server reads Cloudflare's own"
      echo "usage meter every 10 minutes and switches the relay off at your budget, so it"
      echo "can't run into paid use. You need four things from the Cloudflare dashboard:"
      echo "  1. Realtime > TURN Server > your key: the ${B}Turn Token ID${N} and its ${B}API Token${N}"
      echo "  2. Your ${B}Account ID${N} (Account home, the ... menu > Copy account ID)"
      echo "  3. An ${B}analytics token${N}: My Profile > API Tokens > Create Token > Custom token,"
      echo "     permission: Account / Account Analytics / Read (nothing else)"
      echo
      printf 'Turn Token ID: '; read -r id
      printf 'TURN API Token (hidden): '; read -rs tok; echo
      printf 'Account ID: '; read -r acct
      printf 'Analytics token (hidden): '; read -rs an; echo
      printf 'Monthly budget in GB [500]: '; read -r bud
      id="$(printf '%s' "$id" | tr -d '[:space:]')"; tok="$(printf '%s' "$tok" | tr -d '[:space:]')"
      acct="$(printf '%s' "$acct" | tr -d '[:space:]')"; an="$(printf '%s' "$an" | tr -d '[:space:]')"
      bud="$(printf '%s' "${bud:-500}" | tr -cd '0-9')"; [ -z "$bud" ] && bud=500
      [ "$bud" -gt 950 ] && { echo "${Y}Budget capped at 950 GB${N} (the free amount is 1,000)."; bud=950; }
      if [ -z "$id" ] || [ -z "$tok" ] || [ -z "$acct" ] || [ -z "$an" ]; then echo "${R}All four are needed${N} (without the meter the relay stays off). Nothing changed."; exit 1; fi
      tmp="$(mktemp)"
      jq -n --arg id "$id" --arg t "$tok" --arg a "$acct" --arg an "$an" --argjson b "$bud" '{kind: "cloudflare", id: $id, token: $t, account: $a, analytics: $an, budgetGB: $b}' > "$tmp" &&
        S install -m 600 -o dashparty -g dashparty "$tmp" "$f" || { rm -f "$tmp"; echo "${R}Couldn't save it.${N}"; exit 1; }
      rm -f "$tmp"
      echo "${G}Saved.${N} Restarting the server so it reads the meter now..."
      S systemctl restart dash-party; sleep 8; turn ;;
    pi)
      # [v1.6] all by itself: no questions, it opens the router's ports (UPnP) and
      # follows your home IP when it changes (see /opt/dash-party/dash-relay)
      echo "Setting up a relay on this Pi (free, uses your home internet)."
      echo "${Y}Players linking through it can see your home IP address.${N}"
      if [ ! -x /opt/dash-party/dash-relay ]; then echo "${R}This Pi has an older setup.${N} Run ${B}dash-party update${N} first, then this again."; exit 1; fi
      S /opt/dash-party/dash-relay setup "${2:-}" || exit 1
      echo; sleep 2; turn ;;
    guide) turn_guide ;;
    off)
      S /opt/dash-party/dash-relay off 2>/dev/null || { S rm -f "$f"; S systemctl disable --now coturn >/dev/null 2>&1 || true; }
      S rm -f "$f"
      echo "Relay turned off (games link directly only, within a minute)." ;;
    *)
      if ! S test -r "$f"; then
        echo "${Y}No relay set up.${N} Players whose networks block direct links can't join."
        echo "  ${B}dash-party turn set${N}  Cloudflare's relay (free up to 1,000 GB, with a shutoff)"
        echo "  ${B}dash-party turn pi${N}   a relay on this Pi (free; it opens your router's ports by itself)"; return
      fi
      j="$(curl -fsS -m 15 http://127.0.0.1:8787/api/turn 2>/dev/null)"
      if [ -z "$j" ]; then echo "${R}The server didn't answer.${N} Try: dash-party errors"; return; fi
      if [ "$(printf '%s' "$j" | jq -r .on)" = "true" ]; then
        if [ "$(printf '%s' "$j" | jq -r .kind)" = "pi" ]; then
          echo "${G}Relay on${N} (this Pi). Logins given today: $(printf '%s' "$j" | jq -r .loginsToday)"
          S systemctl is-active --quiet coturn || echo "${R}But coturn isn't running.${N} Try: sudo systemctl restart coturn"
          local rs; rs="$(S cat "$DATA/relay.json" 2>/dev/null)"
          if [ "$(printf '%s' "$rs" | jq -r '.doubleNat' 2>/dev/null)" = true ]; then
            echo "${R}Your internet provider shares one address between many homes${N} (your router's"
            echo "internet address is a private one), so players can't reach a relay at home."
            echo "Use Cloudflare's relay instead: ${B}dash-party turn set${N}"
          elif [ "$(printf '%s' "$rs" | jq -r '.upnp' 2>/dev/null)" = ok ]; then
            echo "${G}Router ports open${N} (the Pi opened them itself, and keeps them open)."
          else
            echo "${Y}The router's ports aren't open yet:${N} your router didn't let the Pi open them."
            echo "Do it by hand once: ${B}dash-party turn guide${N} (step by step)"
          fi
          echo "${D}It follows your home IP by itself when it changes.${N}"
        else
          echo "${G}Relay on${N} (Cloudflare). This month: $(printf '%s' "$j" | jq -r .gb) GB of your $(printf '%s' "$j" | jq -r .budgetGB) GB budget."
          echo "Logins given today: $(printf '%s' "$j" | jq -r .loginsToday)"
        fi
      else
        echo "${Y}Relay off:${N} $(printf '%s' "$j" | jq -r .why)"
        echo "Details: dash-party errors"
      fi ;;
  esac
}

case "${1:-}" in
  ""|status)
    S true >/dev/null
    trap 'tput cnorm 2>/dev/null; echo; exit 0' INT
    tput civis 2>/dev/null
    while true; do dashboard; sleep 3; done ;;
  once) S true >/dev/null; dashboard ;;
  log) echo "${D}Ctrl+C to leave${N}"; S tail -n 30 -F "$DATA/watchdog.log" & journalctl -u dash-party -u dash-tunnel -f -n 30 --no-pager; kill %1 2>/dev/null ;;
  errors) journalctl -u dash-party -u dash-tunnel -p warning --since '-3d' --no-pager | tail -n 60; S grep -E 'PROBLEM' "$DATA/watchdog.log" | tail -n 30 ;;
  keys)
    echo "${Y}${B}Keep these private.${N} Give Kineto his key in a private message. Never post them."
    echo; S cat "$ETC/admin-keys.txt" ;;
  setkey) setkey "${2:-}" ;;
  history) history "${2:-}" ;;
  stats) stats ;;
  notify) notify "${2:-}" ;;
  turn) turn "${2:-}" "${3:-}" ;;
  bans) S cat "$DATA/bans.json" 2>/dev/null | jq -r '.[] | "\(.at)  \(.name)  (by \(.by))"' 2>/dev/null || echo "Nobody is banned." ;;
  unban)
    [ -z "${2:-}" ] && { echo "Use: dash-party unban NAME"; exit 1; }
    name="$(printf '%s' "$2" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9 _.-')"
    S sh -c "jq --arg n '$name' '[.[] | select((.name | ascii_downcase) != \$n)]' $DATA/bans.json > $DATA/bans.json.tmp && mv $DATA/bans.json.tmp $DATA/bans.json && chown dashparty:dashparty $DATA/bans.json && chmod 600 $DATA/bans.json" && echo "Unbanned $2 (if they were banned)." ;;
  restart) S systemctl restart dash-party dash-tunnel && echo "${G}Restarted.${N}" ;;
  fix) S /opt/dash-party/dash-watchdog; echo "Done. $(S tail -n 3 "$DATA/watchdog.log")" ;;
  update) curl -fsSL "https://raw.githubusercontent.com/ActuallyDigitsofpi314159/Dash-Parkour/main/dash-server/setup.sh" | bash ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
